# Git = histórico local dos textos do fluxo (skills, normas, ferramentas, estados, páginas, mixagens).
# A pasta inteira (com a mídia) vai para o Drive; a mídia fica fora do Git para ele não pesar.

# dependências, caches e configurações locais
node_modules/
__pycache__/
ferramentas/_cache_busca/
.claude/settings.local.json

# mídia pesada e material institucional (vai pelo Drive)
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.jpg
*.jpeg
*.png
*.webp
*.psd
*.pdf
*.PDF
*.rar
*.zip
*.7z

# exceções: o que o pipeline usa direto
!biblioteca/sfx/**
!biblioteca/marca/fontes/**
!biblioteca/marca/cores/**

# cópias para envio (o original fica em <SERVIÇO>/roteiro/)
roteiros para enviar/

# gerado a cada teste do Playwright (tem caminho absoluto da máquina)
ferramentas/_teste.html
